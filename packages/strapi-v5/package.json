{
  "name": "strapi-plugin-line-rich-menu",
  "version": "1.1.1",
  "description": "Design, schedule and publish LINE rich menus from the Strapi 5 admin panel",
  "license": "Apache-2.0",
  "author": "Fosivo Labs Co., Ltd. <https://fosivo.com>",
  "contributors": [
    {
      "name": "Narenrit Hadsadintorn",
      "url": "https://github.com/captainkie"
    },
    {
      "name": "Claude (Anthropic)",
      "url": "https://claude.com/claude-code"
    }
  ],
  "homepage": "https://github.com/captainkie/strapi-plugin-line-rich-menu#readme",
  "bugs": {
    "url": "https://github.com/captainkie/strapi-plugin-line-rich-menu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/captainkie/strapi-plugin-line-rich-menu.git",
    "directory": "packages/strapi-v5"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "line",
    "rich-menu",
    "line-messaging-api",
    "line-oa"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "strapi": {
    "name": "line-rich-menu",
    "displayName": "LINE Rich Menu",
    "description": "Build, schedule and publish LINE rich menus from the Strapi admin panel",
    "kind": "plugin"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-runtime-deps.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/utils": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.4.1",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@fosivo/line-rich-menu-core": "workspace:*",
    "@fosivo/line-rich-menu-ui": "workspace:*",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/utils": "^5.52.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.4.1",
    "react-router-dom": "^6.26.2",
    "styled-components": "^6.1.13"
  }
}
