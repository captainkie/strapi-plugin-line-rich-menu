{
  "name": "line-rich-menu",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "pnpm --filter @fosivo/line-rich-menu-core exec stryker run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "verify": "pnpm --filter strapi-plugin-line-rich-menu verify",
    "check:deps": "pnpm --filter strapi-plugin-line-rich-menu-v4 check:deps && pnpm --filter strapi-plugin-line-rich-menu check:deps",
    "e2e:v4": "bash examples/v4-app/scripts/e2e.sh",
    "e2e:v5": "bash examples/v5-app/scripts/e2e.sh",
    "screenshots": "bash examples/v5-app/scripts/screenshots.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "tsup>esbuild": "^0.28.2",
      "typed-rest-client>qs": "^6.15.3"
    }
  },
  "license": "AGPL-3.0-only"
}
