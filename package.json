{
  "name": "line-rich-menu",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "pnpm --filter @fosivo/line-rich-menu-core exec stryker run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.12.0",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "tsup>esbuild": "^0.28.2",
      "typed-rest-client>qs": "^6.15.3"
    }
  },
  "license": "AGPL-3.0-only"
}
